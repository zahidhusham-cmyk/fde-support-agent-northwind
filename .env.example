# Copy to .env and fill in. .env is gitignored; never commit real values.

# ServiceNow Personal Developer Instance (developer.servicenow.com > Manage my Instance)
SERVICENOW_INSTANCE=dev12345          # instance name, or full URL https://dev12345.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=

# OPTIONAL: Stripe sandbox (test mode) secret key, only if you move billing to Stripe.
# Billing stays in SQLite by default. Must start with sk_test_. Live keys are refused.
STRIPE_SECRET_KEY=sk_test_

# Mock network/device API (uvicorn mock_network.app:app --port 8300)
NETWORK_API_URL=http://localhost:8300

# Support agent (northwind/agent.py). Key from console.x.ai. Never commit the real key.
XAI_API_KEY=
GROK_MODEL=grok-4
